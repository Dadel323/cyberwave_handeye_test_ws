diff --git a/openarm_hardware/src/openarm_simple_hardware.cpp b/openarm_hardware/src/openarm_simple_hardware.cpp
index 9321c4a..fc4ed35 100644
--- a/openarm_hardware/src/openarm_simple_hardware.cpp
+++ b/openarm_hardware/src/openarm_simple_hardware.cpp
@@ -229,7 +229,28 @@ hardware_interface::CallbackReturn OpenArmHW::on_activate(
   openarm_->recv_all();
 
   // Return to zero position
-  return_to_zero();
+  // return_to_zero();
+  // Hold current position instead of returning to zero
+  openarm_->refresh_all();
+  std::this_thread::sleep_for(std::chrono::milliseconds(10));
+  openarm_->recv_all();
+
+  const auto& arm_motors = openarm_->get_arm().get_motors();
+  for (size_t i = 0; i < ARM_DOF && i < arm_motors.size(); ++i) {
+    pos_states_[i] = arm_motors[i].get_position();
+    pos_commands_[i] = pos_states_[i];
+    vel_commands_[i] = 0.0;
+    tau_commands_[i] = 0.0;
+  }
+
+  if (hand_ && joint_names_.size() > ARM_DOF) {
+    const auto& gripper_motors = openarm_->get_gripper().get_motors();
+    if (!gripper_motors.empty()) {
+      pos_states_[ARM_DOF] =
+          motor_radians_to_joint(gripper_motors[0].get_position());
+      pos_commands_[ARM_DOF] = pos_states_[ARM_DOF];
+    }
+  }
 
   RCLCPP_INFO(rclcpp::get_logger("OpenArmHW"), "OpenArm V10 activated");
   return CallbackReturn::SUCCESS;
