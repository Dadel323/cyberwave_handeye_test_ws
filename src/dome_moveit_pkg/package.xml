<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dome_moveit_pkg</name>
  <version>0.0.0</version>
  <description>Request-driven dome-pose mover: on each move_to_next_point service call,
    samples a random reachable pose on a hemisphere around a configured center point,
    IK/cartesian-checks it via MoveIt, and executes it. Drop-in alternative to
    handeye_calibration's run_points_node for hand-eye calibration data collection.</description>
  <maintainer email="cyb@todo.todo">cyb</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>moveit_msgs</depend>
  <depend>moveit_ros_planning_interface</depend>
  <depend>sensor_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>shape_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>handeye_calibration_interfaces</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
